      <target dev="hdb" bus="virtio"/>
      <readonly/>
    </disk>
    <disk type="block" device="disk">
      <source dev="/dev/onapp-ufevliekwvznhd/pdirxsyhjruusy"/>
      <target dev="vda" bus="virtio"/>
      <driver type="raw" name="qemu" cache="none" discard="ignore"/>
    </disk>
    <disk type="file" device="cdrom">
      <source file="/onapp/tools/scripts/scripts.iso"/>
      <target dev="hdc" bus="ide"/>
      <readonly/>
    </disk>

 <serial type='pty'>
   <target port='0'/>
 </serial>
 <console type='pty'>
   <target type='serial' port='0'/>
 </console>
    <input type="tablet" bus="usb"/>
  </devices>
  <qemu:commandline>
    <qemu:arg value="-global"/>
    <qemu:arg value="virtio-pci.disable-modern=on"/>
  </qemu:commandline>
</domain>

